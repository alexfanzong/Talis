CONFIG_PROJECT_NAME="Talis"
CONFIG_PROJECT_VERSION="0.2.0"

# ---- 板级 ----
# 保留板级选择：其 Kconfig 负责 select ENABLE_DISPLAY / ENABLE_TP / ENABLE_BUTTON
# 以及提供 DISPLAY_NAME / BUTTON_NAME / AUDIO_CODEC_NAME 宏。
# 但外设注册代码用的是项目本地的 src/board/talis_board.c，不是 SDK 的 board_com_api.c
CONFIG_BOARD_CHOICE_T5AI=y
CONFIG_BOARD_CHOICE_SPARKLEIOT_T5AI_DEV=y

# ---- LVGL ----
# 必须显式指定版本，SDK 默认是 v9，而 pocket_ai 的 screen_manager 按 v8 写的
CONFIG_ENABLE_LIBLVGL=y
CONFIG_LVGL_VERSION_8=y
CONFIG_LVGL_V8_COLOR_DEPTH_16=y
CONFIG_ENABLE_LVGL_TP=y

# 字体：界面用 src/ui/fonts 下自建的 lv_font_talis_*（含法语重音）。
# 内置 montserrat 只保留 14 —— LV_FONT_DEFAULT 指向它，不能关；
# 其余字号关掉省 flash，界面里已经不引用了。
CONFIG_LV_FONT_MONTSERRAT_14=y

# ---- 音频播放（预录求助语音）----
CONFIG_ENABLE_AI_PLAYER=y

CONFIG_ENABLE_MBEDTLS_SSL_MAX_CONTENT_LEN=4096
